---
/** Closing call to action and footer. */
import InviteLink from "./InviteLink.astro";
import Logo from "./Logo.astro";
import { SITE } from "@/lib/site";
---

<section class="relative border-t border-line">
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-x-0 bottom-0 h-[70%] bg-[radial-gradient(60%_80%_at_50%_100%,rgb(169_212_255/0.10),transparent_70%)]"
  >
  </div>
  <div class="gutter reveal relative flex flex-col items-center gap-5.5 py-24 text-center sm:py-30">
    <span class="eyebrow">{SITE.domain}</span>
    <h2 class="text-[clamp(36px,5.6vw,64px)] leading-[1.05] font-medium tracking-[-0.03em]">
      Keep your real address <em>to yourself.</em>
    </h2>
    <p class="lede mx-auto">
      closet-mail is invite only. Ask for an invite and you'll get a link to set up your account. Prefer your own
      server? The source is on GitHub.
    </p>
    <div class="flex flex-wrap justify-center gap-3">
      <InviteLink />
      <a class="btn btn-ghost" href={SITE.repoUrl}>Run your own</a>
    </div>
    <p class="text-[13px] text-dim">
      Mail app didn't open? Write to <span class="font-mono text-muted select-all">{SITE.inviteEmail}</span>
    </p>
  </div>
</section>

<footer class="border-t border-line py-9 text-[13px] text-dim">
  <div class="gutter flex flex-wrap items-center gap-x-7 gap-y-3.5">
    <span class="flex items-center gap-2.5 font-semibold text-fg"><Logo />{SITE.name}</span>
    <span class="flex-1">An email alias service, self-hosted on a home server.</span>
    <a class="hover:text-fg" href={SITE.appUrl}>Sign in</a>
    <a class="hover:text-fg" href={SITE.repoUrl}>GitHub</a>
    <a class="hover:text-fg" href={`${SITE.repoUrl}/blob/main/LICENSE`}>AGPL-3.0</a>
    <a class="hover:text-fg" href={`${SITE.repoUrl}/blob/main/SECURITY.md`}>Security</a>
  </div>
</footer>
