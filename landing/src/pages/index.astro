---
/** The public landing page for closetcompute.online. */
import Api from "@/components/Api.astro";
import Closing from "@/components/Closing.astro";
import Features from "@/components/Features.astro";
import Hero from "@/components/Hero.astro";
import HowItWorks from "@/components/HowItWorks.astro";
import Nav from "@/components/Nav.astro";
import Privacy from "@/components/Privacy.astro";
import Base from "@/layouts/Base.astro";
---

<Base
  title="closet-mail · email aliases for every site"
  description="closet-mail gives every website its own email address. Mail reaches your real inbox, replies go out as the alias, and your real address stays private. Open source and self-hosted."
>
  <Nav />
  <main id="top">
    <Hero />
    <HowItWorks />
    <Features />
    <Api />
    <Privacy />
  </main>
  <Closing />
</Base>
