# Copy to deploy/.env (mode 600) and fill in real values. Never commit the real file.
# Local dev overrides (DB/Redis on localhost, dev keys) go in backend/.env.
# In production, compose sets DATABASE_URL, REDIS_URL, RSPAMD_URL and LOG_DIR itself; the app
# secrets, APP_ENV and APP_BASE_URL come from deploy/.env.prod (deploy/scripts/gen-prod-secrets.sh).

# --- app
APP_ENV=dev
APP_BASE_URL=https://app.closetcompute.online
LOG_DIR=./logs
ALIAS_DOMAIN=closetcompute.online
REPLY_DOMAIN=rp.closetcompute.online
SYSTEM_FROM=noreply@closetcompute.online

# --- datastores
DATABASE_URL=postgresql+asyncpg://mailalias:mailalias@localhost:5433/mailalias
PROD_DATABASE_URL=postgresql+asyncpg://mailalias:change-me@global-postgres:5432/mailalias
REDIS_URL=redis://localhost:6380/3

# --- keys (generate once; losing them makes encrypted data unreadable)
DATA_ENCRYPTION_KEY=generate-with-Fernet.generate_key
HASH_KEY=64-hex-chars
SIGNING_KEY=random-urlsafe-string
BACKUP_PASSPHRASE=random-passphrase
PG_DUMP_BIN=pg_dump

# --- Cloudflare
CF_ACCOUNT_ID=0000000000000000000000000000000
CF_ZONE_ID=0000000000000000000000000000000
CF_API_TOKEN=cf-token
CF_KV_NAMESPACE_ID=0000000000000000000000000000000
CF_QUEUE_ID_INBOUND=0000000000000000000000000000000
CF_QUEUE_ID_DLQ=0000000000000000000000000000000
R2_ACCESS_KEY_ID=r2-key-id
R2_SECRET_ACCESS_KEY=r2-secret
R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
R2_BUCKET=mail-inbox

# --- Resend
RESEND_API_KEY=re_xxx
RESEND_SMTP_HOST=smtp.resend.com
RESEND_SMTP_PORT=465
RESEND_WEBHOOK_SECRET=whsec_xxx

# --- spam
RSPAMD_URL=http://localhost:11333
SPAM_QUARANTINE_SCORE=6
SPAM_DISCARD_SCORE=15
SPAM_CHECK_TIMEOUT_SECONDS=20
QUARANTINE_DAYS=7

# --- limits
OUTBOUND_DAILY_CAP=95
USER_REPLIES_PER_DAY=50
USER_FORWARDS_PER_HOUR=500
USER_ALIAS_CREATES_PER_HOUR=20

# --- processor
PROCESSOR_BATCH=10
PROCESSOR_CONCURRENCY=4
PROCESSOR_VISIBILITY_MS=120000

# --- deploy target for deploy/scripts/deploy.sh
DEPLOY_HOST=user@your-server

# --- spikes / manual tests only
SPIKE_TO=you@example.com
